{
  "expo": {
    "name": "MyExpoStructure",
    "slug": "myexpostructure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "myexpostructure",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/expo.icon",
      "bundleIdentifier": "com.darshan8699.myexpostructure",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos to compare image colors.",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos to your photo library.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to take photos for color analysis.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone."
      },
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.darshan8699.myexpostructure",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./src/assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@sentry/react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you compare image colors.",
          "cameraPermission": "The app accesses your camera to let you take photos for color analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "16dbf4dd-24ff-4330-ab57-941c15748b5c"
      }
    },
    "owner": "darshanrana"
  }
}
